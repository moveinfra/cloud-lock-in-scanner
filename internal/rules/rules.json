{
  "schema_version": 1,
  "rules": [
    {
      "id": "aws.network-iam",
      "group": true,
      "cloud": "aws",
      "service": "Networking & IAM",
      "class": "portable",
      "capability": "networking",
      "replacement": "UpCloud SDN private networks, Scaleway VPC and Private Networks, Hetzner Networks and Firewalls, OVHcloud vRack private networks; IAM becomes API tokens and RBAC",
      "terraform": ["aws_iam_*", "aws_vpc", "aws_vpc_*", "aws_vpcs", "aws_subnet", "aws_subnets", "aws_default_*", "aws_security_group", "aws_security_group_rule", "aws_security_groups", "aws_route", "aws_route_table", "aws_route_table_association", "aws_main_route_table_association", "aws_internet_gateway", "aws_internet_gateway_attachment", "aws_egress_only_internet_gateway", "aws_nat_gateway", "aws_eip", "aws_eip_association", "aws_network_acl", "aws_network_acl_*", "aws_network_interface", "aws_network_interface_*", "aws_ec2_transit_gateway*", "aws_vpn_*", "aws_customer_gateway", "aws_flow_log", "aws_key_pair", "aws_caller_identity", "aws_region", "aws_regions", "aws_partition", "aws_availability_zone", "aws_availability_zones", "aws_organizations_*", "aws_ssoadmin_*", "aws_identitystore_*"],
      "cloudformation": ["AWS::IAM::*", "AWS::EC2::VPC*", "AWS::EC2::Subnet*", "AWS::EC2::SecurityGroup*", "AWS::EC2::Route*", "AWS::EC2::InternetGateway", "AWS::EC2::EgressOnlyInternetGateway", "AWS::EC2::NatGateway", "AWS::EC2::EIP*", "AWS::EC2::NetworkAcl*", "AWS::EC2::NetworkInterface*", "AWS::EC2::TransitGateway*", "AWS::EC2::VPNGateway*", "AWS::EC2::CustomerGateway", "AWS::EC2::FlowLog", "AWS::EC2::KeyPair", "AWS::CloudFormation::*", "AWS::CDK::Metadata", "AWS::Organizations::*", "AWS::SSO::*"],
      "sdk": ["iam", "sts", "sso*", "organizations", "identitystore", "cloudformation"]
    },
    {
      "id": "aws.ec2",
      "cloud": "aws",
      "service": "EC2 / Lightsail",
      "class": "portable",
      "capability": "compute",
      "replacement": "UpCloud Cloud Servers, Scaleway Instances, Hetzner Cloud Servers, OVHcloud Public Cloud Instances",
      "terraform": ["aws_instance", "aws_instances", "aws_launch_template", "aws_launch_configuration", "aws_autoscaling_*", "aws_ami", "aws_ami_*", "aws_ebs_*", "aws_volume_attachment", "aws_placement_group", "aws_spot_*", "aws_ec2_*", "aws_lightsail_*"],
      "cloudformation": ["AWS::EC2::*", "AWS::AutoScaling::*", "AWS::Lightsail::*"],
      "sdk": ["ec2", "autoscaling", "ebs", "lightsail"]
    },
    {
      "id": "aws.s3",
      "cloud": "aws",
      "service": "S3",
      "class": "portable",
      "capability": "object-storage",
      "replacement": "UpCloud Managed Object Storage, Scaleway Object Storage, Hetzner Object Storage, OVHcloud Object Storage (S3 API)",
      "terraform": ["aws_s3_*", "aws_s3control_*"],
      "cloudformation": ["AWS::S3::*"],
      "sdk": ["s3*"]
    },
    {
      "id": "aws.rds",
      "cloud": "aws",
      "service": "RDS / Aurora (provisioned)",
      "class": "portable",
      "capability": "managed-postgres",
      "replacement": "UpCloud Managed PostgreSQL / MySQL, Scaleway Managed Database for PostgreSQL / MySQL, OVHcloud Managed Databases for PostgreSQL / MySQL, or PostgreSQL / MySQL on Hetzner Cloud Servers",
      "terraform": ["aws_db_*", "aws_rds_*"],
      "cloudformation": ["AWS::RDS::*"],
      "sdk": ["rds*"]
    },
    {
      "id": "aws.aurora-serverless",
      "cloud": "aws",
      "service": "Aurora Serverless / RDS Data API",
      "class": "hard",
      "capability": "managed-postgres",
      "replacement": "A fixed-size managed PostgreSQL / MySQL (UpCloud, Scaleway, OVHcloud); Data API calls need a normal driver and connection pool",
      "terraform": ["aws_rds_cluster", "aws_rds_cluster_instance"],
      "terraform_body": ["engine_mode\\s*=\\s*\"serverless\"", "serverlessv2_scaling_configuration", "enable_http_endpoint\\s*=\\s*true", "instance_class\\s*=\\s*\"db\\.serverless\""],
      "sdk": ["rdsdata"]
    },
    {
      "id": "aws.elasticache",
      "cloud": "aws",
      "service": "ElastiCache / MemoryDB",
      "class": "portable",
      "capability": "redis",
      "replacement": "UpCloud Managed Valkey, Scaleway Managed Redis, OVHcloud Managed Databases for Caching, or Valkey on Hetzner Cloud Servers",
      "terraform": ["aws_elasticache_*", "aws_memorydb_*"],
      "cloudformation": ["AWS::ElastiCache::*", "AWS::MemoryDB::*"],
      "sdk": ["elasticache", "memorydb"]
    },
    {
      "id": "aws.eks",
      "cloud": "aws",
      "service": "EKS",
      "class": "portable",
      "capability": "kubernetes",
      "replacement": "UpCloud Managed Kubernetes, Scaleway Kubernetes Kapsule, OVHcloud Managed Kubernetes Service, or self-managed Kubernetes on Hetzner Cloud Servers",
      "terraform": ["aws_eks_*"],
      "cloudformation": ["AWS::EKS::*"],
      "sdk": ["eks"]
    },
    {
      "id": "aws.elb",
      "cloud": "aws",
      "service": "Elastic Load Balancing (ALB, NLB)",
      "class": "portable",
      "capability": "load-balancer",
      "replacement": "UpCloud Managed Load Balancer, Scaleway Load Balancer, Hetzner Load Balancer, OVHcloud Public Cloud Load Balancer",
      "terraform": ["aws_lb", "aws_lb_*", "aws_alb", "aws_alb_*", "aws_elb", "aws_elb_*", "aws_load_balancer_*", "aws_proxy_protocol_policy"],
      "cloudformation": ["AWS::ElasticLoadBalancing::*", "AWS::ElasticLoadBalancingV2::*"],
      "sdk": ["elasticloadbalancing*", "elb*"]
    },
    {
      "id": "aws.route53",
      "cloud": "aws",
      "service": "Route 53",
      "class": "portable",
      "capability": "dns",
      "replacement": "Scaleway Domains and DNS, Hetzner DNS, OVHcloud DNS, or another EU DNS provider; zone export and import",
      "terraform": ["aws_route53_*"],
      "cloudformation": ["AWS::Route53::*", "AWS::Route53Resolver::*"],
      "sdk": ["route53*"]
    },
    {
      "id": "aws.ecr",
      "cloud": "aws",
      "service": "ECR",
      "class": "portable",
      "replacement": "Any OCI registry: Harbor, or the target cloud's container registry",
      "terraform": ["aws_ecr_*", "aws_ecrpublic_*"],
      "cloudformation": ["AWS::ECR::*"],
      "sdk": ["ecr*"]
    },
    {
      "id": "aws.efs",
      "cloud": "aws",
      "service": "EFS / FSx",
      "class": "portable",
      "replacement": "NFS on servers, or the target cloud's file storage",
      "terraform": ["aws_efs_*", "aws_fsx_*"],
      "cloudformation": ["AWS::EFS::*", "AWS::FSx::*"],
      "sdk": ["efs", "fsx"]
    },
    {
      "id": "aws.opensearch",
      "cloud": "aws",
      "service": "OpenSearch Service",
      "class": "portable",
      "replacement": "OpenSearch you run on servers or Kubernetes, or a managed OpenSearch on the target cloud",
      "terraform": ["aws_opensearch_*", "aws_opensearchserverless_*", "aws_elasticsearch_*"],
      "cloudformation": ["AWS::OpenSearchService::*", "AWS::OpenSearchServerless::*", "AWS::Elasticsearch::*"],
      "sdk": ["opensearch*", "elasticsearch*", "es"]
    },
    {
      "id": "aws.mq",
      "cloud": "aws",
      "service": "Amazon MQ",
      "class": "portable",
      "capability": "queues",
      "replacement": "RabbitMQ or ActiveMQ on servers; OVHcloud Managed Kafka or RabbitMQ on servers",
      "terraform": ["aws_mq_*"],
      "cloudformation": ["AWS::AmazonMQ::*"],
      "sdk": ["mq", "amazonmq"]
    },
    {
      "id": "aws.msk",
      "cloud": "aws",
      "service": "MSK (Kafka)",
      "class": "portable",
      "capability": "queues",
      "replacement": "Kafka: OVHcloud Managed Kafka, or Kafka / Redpanda you run",
      "terraform": ["aws_msk_*", "aws_mskconnect_*"],
      "cloudformation": ["AWS::MSK::*", "AWS::KafkaConnect::*"],
      "sdk": ["kafka", "kafkaconnect", "msk"]
    },
    {
      "id": "aws.acm",
      "cloud": "aws",
      "service": "Certificate Manager",
      "class": "portable",
      "replacement": "Let's Encrypt via cert-manager, or certificates on the target load balancer",
      "terraform": ["aws_acm_*", "aws_acmpca_*"],
      "cloudformation": ["AWS::CertificateManager::*", "AWS::ACMPCA::*"],
      "sdk": ["acm*", "certificatemanager"]
    },
    {
      "id": "aws.ecs",
      "cloud": "aws",
      "service": "ECS / Fargate",
      "class": "moderate",
      "capability": "kubernetes",
      "replacement": "Kubernetes on the target (UpCloud Managed Kubernetes, Scaleway Kubernetes Kapsule, OVHcloud Managed Kubernetes Service); task definitions become Deployments",
      "terraform": ["aws_ecs_*", "aws_appautoscaling_*"],
      "cloudformation": ["AWS::ECS::*", "AWS::ApplicationAutoScaling::*"],
      "sdk": ["ecs*", "applicationautoscaling"]
    },
    {
      "id": "aws.beanstalk",
      "cloud": "aws",
      "service": "Elastic Beanstalk / App Runner",
      "class": "moderate",
      "replacement": "Containers on Kubernetes or on servers; platform configuration needs rewriting",
      "terraform": ["aws_elastic_beanstalk_*", "aws_apprunner_*"],
      "cloudformation": ["AWS::ElasticBeanstalk::*", "AWS::AppRunner::*"],
      "sdk": ["elasticbeanstalk", "apprunner*"]
    },
    {
      "id": "aws.sqs",
      "cloud": "aws",
      "service": "SQS",
      "class": "moderate",
      "capability": "queues",
      "replacement": "Scaleway Queues and Topics (SQS/SNS-compatible), or NATS / RabbitMQ on servers",
      "terraform": ["aws_sqs_*"],
      "cloudformation": ["AWS::SQS::*"],
      "sdk": ["sqs"]
    },
    {
      "id": "aws.sns",
      "cloud": "aws",
      "service": "SNS",
      "class": "moderate",
      "capability": "queues",
      "replacement": "Scaleway Queues and Topics (SQS/SNS-compatible), or NATS / RabbitMQ on servers",
      "terraform": ["aws_sns_*"],
      "cloudformation": ["AWS::SNS::*"],
      "sdk": ["sns*"]
    },
    {
      "id": "aws.eventbridge",
      "cloud": "aws",
      "service": "EventBridge / Scheduler",
      "class": "moderate",
      "capability": "queues",
      "replacement": "NATS or RabbitMQ for events, Kubernetes CronJobs for schedules",
      "terraform": ["aws_cloudwatch_event_*", "aws_scheduler_*", "aws_pipes_*", "aws_schemas_*"],
      "cloudformation": ["AWS::Events::*", "AWS::Scheduler::*", "AWS::Pipes::*", "AWS::EventSchemas::*"],
      "sdk": ["eventbridge", "events*", "cloudwatchevents", "scheduler", "pipes", "schemas"]
    },
    {
      "id": "aws.secrets",
      "cloud": "aws",
      "service": "Secrets Manager / Systems Manager",
      "class": "moderate",
      "replacement": "OpenBao or HashiCorp Vault, or Kubernetes Secrets with External Secrets or SOPS",
      "terraform": ["aws_secretsmanager_*", "aws_ssm_*"],
      "cloudformation": ["AWS::SecretsManager::*", "AWS::SSM::*"],
      "sdk": ["secretsmanager", "ssm"]
    },
    {
      "id": "aws.kms",
      "cloud": "aws",
      "service": "KMS",
      "class": "moderate",
      "replacement": "OpenBao or Vault Transit, or the target cloud's key management; data encrypted with KMS keys must be re-encrypted",
      "terraform": ["aws_kms_*"],
      "cloudformation": ["AWS::KMS::*"],
      "sdk": ["kms"]
    },
    {
      "id": "aws.cloudfront",
      "cloud": "aws",
      "service": "CloudFront",
      "class": "moderate",
      "replacement": "An EU CDN or a caching proxy (Varnish, NGINX); CloudFront Functions and Lambda@Edge need a rewrite",
      "terraform": ["aws_cloudfront_*"],
      "cloudformation": ["AWS::CloudFront::*"],
      "sdk": ["cloudfront*"]
    },
    {
      "id": "aws.waf",
      "cloud": "aws",
      "service": "WAF / Shield",
      "class": "moderate",
      "replacement": "A WAF in the ingress (Coraza, ModSecurity) or at an EU edge provider; rules need rewriting",
      "terraform": ["aws_waf_*", "aws_wafv2_*", "aws_wafregional_*", "aws_shield_*"],
      "cloudformation": ["AWS::WAF::*", "AWS::WAFv2::*", "AWS::WAFRegional::*", "AWS::Shield::*"],
      "sdk": ["waf*", "shield"]
    },
    {
      "id": "aws.cloudwatch",
      "cloud": "aws",
      "service": "CloudWatch / X-Ray",
      "class": "moderate",
      "replacement": "Prometheus, Grafana and Loki, or OpenTelemetry to any backend",
      "terraform": ["aws_cloudwatch_*", "aws_xray_*"],
      "cloudformation": ["AWS::CloudWatch::*", "AWS::Logs::*", "AWS::XRay::*"],
      "sdk": ["cloudwatch*", "logs*", "xray"]
    },
    {
      "id": "aws.audit",
      "cloud": "aws",
      "service": "CloudTrail / Config / GuardDuty / Security Hub",
      "class": "moderate",
      "replacement": "Audit logs from the target cloud's API, Falco, and a SIEM you run",
      "terraform": ["aws_cloudtrail*", "aws_config_*", "aws_guardduty_*", "aws_securityhub_*", "aws_inspector*", "aws_macie2_*", "aws_accessanalyzer_*"],
      "cloudformation": ["AWS::CloudTrail::*", "AWS::Config::*", "AWS::GuardDuty::*", "AWS::SecurityHub::*", "AWS::Inspector*", "AWS::Macie::*", "AWS::AccessAnalyzer::*"],
      "sdk": ["cloudtrail", "config", "configservice", "guardduty", "securityhub", "inspector*", "macie*", "accessanalyzer"]
    },
    {
      "id": "aws.backup",
      "cloud": "aws",
      "service": "AWS Backup",
      "class": "moderate",
      "replacement": "Velero, restic, or the target cloud's snapshots and backups",
      "terraform": ["aws_backup_*"],
      "cloudformation": ["AWS::Backup::*"],
      "sdk": ["backup"]
    },
    {
      "id": "aws.cognito",
      "cloud": "aws",
      "service": "Cognito",
      "class": "moderate",
      "replacement": "Keycloak or another OIDC provider; password hashes cannot be exported, so plan a migration on login",
      "terraform": ["aws_cognito_*"],
      "cloudformation": ["AWS::Cognito::*"],
      "sdk": ["cognito*"]
    },
    {
      "id": "aws.ses",
      "cloud": "aws",
      "service": "SES",
      "class": "moderate",
      "replacement": "An EU SMTP or transactional email provider; templates and bounce handling need porting",
      "terraform": ["aws_ses_*", "aws_sesv2_*"],
      "cloudformation": ["AWS::SES::*"],
      "sdk": ["ses*", "pinpoint*"]
    },
    {
      "id": "aws.apigateway",
      "cloud": "aws",
      "service": "API Gateway",
      "class": "moderate",
      "replacement": "An ingress controller or API gateway on Kubernetes (Traefik, Kong, NGINX); authorizers and mappings need rewriting",
      "terraform": ["aws_api_gateway_*", "aws_apigatewayv2_*"],
      "cloudformation": ["AWS::ApiGateway::*", "AWS::ApiGatewayV2::*", "AWS::Serverless::Api", "AWS::Serverless::HttpApi"],
      "sdk": ["apigateway*"]
    },
    {
      "id": "aws.codebuild",
      "cloud": "aws",
      "service": "CodeBuild / CodePipeline / CodeDeploy",
      "class": "moderate",
      "replacement": "GitHub Actions, GitLab CI or Forgejo Actions with self-hosted runners",
      "terraform": ["aws_codebuild_*", "aws_codepipeline*", "aws_codedeploy_*", "aws_codecommit_*", "aws_codeartifact_*", "aws_codestarconnections_*"],
      "cloudformation": ["AWS::CodeBuild::*", "AWS::CodePipeline::*", "AWS::CodeDeploy::*", "AWS::CodeCommit::*", "AWS::CodeArtifact::*"],
      "sdk": ["codebuild", "codepipeline*", "codedeploy", "codecommit", "codeartifact"]
    },
    {
      "id": "aws.analytics",
      "cloud": "aws",
      "service": "Athena / Glue / EMR",
      "class": "moderate",
      "replacement": "Trino or Spark over S3-compatible storage; Glue jobs and the Data Catalog need porting",
      "terraform": ["aws_athena_*", "aws_glue_*", "aws_emr*", "aws_lakeformation_*"],
      "cloudformation": ["AWS::Athena::*", "AWS::Glue::*", "AWS::EMR::*", "AWS::EMRServerless::*", "AWS::LakeFormation::*"],
      "sdk": ["athena", "glue", "emr*", "lakeformation"]
    },
    {
      "id": "aws.documentdb",
      "cloud": "aws",
      "service": "DocumentDB",
      "class": "moderate",
      "replacement": "MongoDB you run, or FerretDB on PostgreSQL; check for DocumentDB-only behaviour",
      "terraform": ["aws_docdb_*", "aws_docdbelastic_*"],
      "cloudformation": ["AWS::DocDB::*", "AWS::DocDBElastic::*"],
      "sdk": ["docdb*"]
    },
    {
      "id": "aws.iot",
      "cloud": "aws",
      "service": "IoT Core",
      "class": "moderate",
      "replacement": "An MQTT broker you run (EMQX, Mosquitto); device shadows, rules and provisioning need a rewrite",
      "terraform": ["aws_iot_*"],
      "cloudformation": ["AWS::IoT::*"],
      "sdk": ["iot*"]
    },
    {
      "id": "aws.lambda",
      "cloud": "aws",
      "service": "Lambda",
      "class": "hard",
      "capability": "functions",
      "replacement": "Containers on Kubernetes, or Scaleway Serverless Functions / Containers; handlers and triggers need repackaging",
      "terraform": ["aws_lambda_*"],
      "cloudformation": ["AWS::Lambda::*", "AWS::Serverless::Function", "AWS::Serverless::LayerVersion", "AWS::Serverless::Application"],
      "sdk": ["lambda*", "sam"]
    },
    {
      "id": "aws.stepfunctions",
      "cloud": "aws",
      "service": "Step Functions",
      "class": "hard",
      "replacement": "A workflow engine such as Temporal or Argo Workflows; state machines need a rewrite",
      "terraform": ["aws_sfn_*"],
      "cloudformation": ["AWS::StepFunctions::*", "AWS::Serverless::StateMachine"],
      "sdk": ["sfn", "stepfunctions*"]
    },
    {
      "id": "aws.dynamodb",
      "cloud": "aws",
      "service": "DynamoDB",
      "class": "hard",
      "capability": "nosql",
      "replacement": "No direct equivalent. Redesign on PostgreSQL (JSONB), or run ScyllaDB, which has a DynamoDB-compatible API",
      "terraform": ["aws_dynamodb_*"],
      "cloudformation": ["AWS::DynamoDB::*", "AWS::Serverless::SimpleTable"],
      "sdk": ["dynamodb*", "dax"]
    },
    {
      "id": "aws.kinesis",
      "cloud": "aws",
      "service": "Kinesis / Firehose",
      "class": "hard",
      "capability": "queues",
      "replacement": "Kafka or Redpanda; producers and consumers need porting from the Kinesis client",
      "terraform": ["aws_kinesis_*", "aws_kinesisanalyticsv2_*"],
      "cloudformation": ["AWS::Kinesis::*", "AWS::KinesisFirehose::*", "AWS::KinesisAnalytics*"],
      "sdk": ["kinesis*", "firehose"]
    },
    {
      "id": "aws.appsync",
      "cloud": "aws",
      "service": "AppSync",
      "class": "hard",
      "replacement": "A GraphQL server you run (Apollo, Hasura); resolvers need a rewrite",
      "terraform": ["aws_appsync_*"],
      "cloudformation": ["AWS::AppSync::*"],
      "sdk": ["appsync"]
    },
    {
      "id": "aws.bedrock",
      "cloud": "aws",
      "service": "Bedrock",
      "class": "hard",
      "replacement": "An EU-hosted model API or open-weight models you serve (vLLM); prompts, agents and knowledge bases need porting",
      "terraform": ["aws_bedrock*"],
      "cloudformation": ["AWS::Bedrock::*"],
      "sdk": ["bedrock*"]
    },
    {
      "id": "aws.sagemaker",
      "cloud": "aws",
      "service": "SageMaker",
      "class": "hard",
      "replacement": "Jupyter, MLflow and GPU nodes on Kubernetes; pipelines and endpoints need a rewrite",
      "terraform": ["aws_sagemaker_*"],
      "cloudformation": ["AWS::SageMaker::*"],
      "sdk": ["sagemaker*"]
    },
    {
      "id": "aws.ai-apis",
      "cloud": "aws",
      "service": "AI APIs (Rekognition, Textract, Comprehend, Polly, Transcribe, Translate, Lex)",
      "class": "hard",
      "replacement": "Open-source models you serve, or EU AI APIs; output formats differ",
      "terraform": ["aws_rekognition_*", "aws_comprehend_*", "aws_transcribe_*", "aws_lex*"],
      "cloudformation": ["AWS::Rekognition::*", "AWS::Comprehend::*", "AWS::Transcribe::*", "AWS::Lex::*"],
      "sdk": ["rekognition", "textract", "comprehend*", "polly", "transcribe*", "translate", "lex*"]
    },
    {
      "id": "aws.redshift",
      "cloud": "aws",
      "service": "Redshift",
      "class": "hard",
      "capability": "warehouse",
      "replacement": "No direct equivalent. A warehouse you run (e.g. ClickHouse); SQL dialect and loaders need porting",
      "terraform": ["aws_redshift_*", "aws_redshiftserverless_*"],
      "cloudformation": ["AWS::Redshift::*", "AWS::RedshiftServerless::*"],
      "sdk": ["redshift*"]
    },

    {
      "id": "gcp.network-iam",
      "group": true,
      "cloud": "gcp",
      "service": "Networking & IAM",
      "class": "portable",
      "capability": "networking",
      "replacement": "UpCloud SDN private networks, Scaleway VPC and Private Networks, Hetzner Networks and Firewalls, OVHcloud vRack private networks; IAM becomes API tokens and RBAC",
      "terraform": ["google_compute_network", "google_compute_network_*", "google_compute_networks", "google_compute_subnetwork", "google_compute_subnetwork_*", "google_compute_firewall", "google_compute_firewall_*", "google_compute_router", "google_compute_router_*", "google_compute_route", "google_compute_address", "google_compute_global_address", "google_compute_vpn_*", "google_compute_ha_vpn_gateway", "google_compute_external_vpn_gateway", "google_compute_shared_vpc_*", "google_compute_zones", "google_compute_regions", "google_vpc_access_connector", "google_service_networking_connection", "google_project", "google_project_*", "google_projects", "google_folder", "google_folder_*", "google_organization", "google_organization_*", "google_service_account", "google_service_account_*", "google_client_config", "google_client_openid_userinfo", "google_billing_*", "google_iam_*"],
      "sdk": ["iam*", "resourcemanager*", "core", "common", "promisify", "paginator", "projectify", "precisedate", "computemetadata", "localauth", "serviceusage"]
    },
    {
      "id": "gcp.compute",
      "cloud": "gcp",
      "service": "Compute Engine",
      "class": "portable",
      "capability": "compute",
      "replacement": "UpCloud Cloud Servers, Scaleway Instances, Hetzner Cloud Servers, OVHcloud Public Cloud Instances",
      "terraform": ["google_compute_*"],
      "sdk": ["compute*"]
    },
    {
      "id": "gcp.lb",
      "cloud": "gcp",
      "service": "Cloud Load Balancing",
      "class": "portable",
